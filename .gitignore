# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# coverage / reports (test-coverage tool output, any depth)
coverage/
# DO NOT REMOVE: packages/sim-core/src/coverage/ is the Coverage Grid SOURCE
# MODULE (P17), not tool output. The unanchored pattern above would silently
# swallow it (and any future file inside), breaking fresh-clone CI. This
# negation re-includes the directory; tool-output dirs stay ignored.
!packages/sim-core/src/coverage/

# environment
.env
.env.*

# editor / OS noise
.DS_Store
Thumbs.db
*.swp

# logs
*.log
.logs/

# python bytecode (scripts/ tooling)
__pycache__/

# import-tool resume state (regenerable)
scripts/.hosting_game_import/

# generated image/video output from the owner's media/prompts/generate.mjs
# batch runs (owner-gen artifacts, node_modules-class: regenerable, stays on
# disk untracked — never stage, never delete)
media/prompts/media/output/

# AssetPack vendor build output + cache (regenerable: pnpm -F @hh/assetpack
# build-kit — the committed contract artifacts live in the kit's manifest/ dir)
assets/skin-kits/.build/
.assetpack/
